# Copie para .env.local só para rodar localmente. NUNCA coloque valores reais aqui.
# Na Vercel, o gvp cuida disto: gvp preflight --fix

# Senha do painel /admin (obrigatória)
ADMIN_PASSWORD=

# Banco MySQL/MariaDB/TiDB (obrigatório para salvar e enviar fotos no painel)
# Formato: mysql://usuario:senha@host:3306/banco  (senha: @ = %40, # = %23)
DATABASE_URL=

# SSL do banco (opcional): false = sem TLS, true = exige TLS. DB_CA só p/ certificado próprio.
DB_SSL=
DB_CA=

# Texto longo aleatório para assinar a sessão do painel (opcional)
APP_SECRET=

# Endereço público do site, se tiver domínio próprio (opcional)
SITE_URL=
